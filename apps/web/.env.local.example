# Supabase project settings (Project Settings -> API in the Supabase dashboard,
# or the values printed by `supabase status` for a local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of apps/api (Fastify backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Show one-click demo accounts on the login page (accounts created by `pnpm seed`)
NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_PASSWORD=AuditDemo@2026
